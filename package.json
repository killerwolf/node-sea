{
  "name": "node-sea",
  "version": "1.0.0",
  "description": "Boilerplate for building a standalone, dependency-free executable from a TypeScript app using Node.js Single Executable Applications (SEA)",
  "private": true,
  "scripts": {
    "test": "node --require ts-node/register --test lib/greeter.test.ts",
    "start": "ts-node hello.ts",
    "clean": "rm -rf dist",
    "build:js": "tsc",
    "build:bundle": "node build-bundle.js",
    "build:sea": "node build-sea.js",
    "build:all": "npm run clean && npm run build:js && npm run build:bundle && npm run build:sea"
  },
  "keywords": ["node", "sea", "single-executable-application", "typescript", "esbuild"],
  "author": "Hamdi LAADHARI",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killerwolf/node-sea.git"
  },
  "homepage": "https://github.com/killerwolf/node-sea#readme",
  "bugs": {
    "url": "https://github.com/killerwolf/node-sea/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
